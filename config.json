  "levels": {
    "_note": "Swing levels on daily candles (the Stock Cockpit's swing.py), rebuilt once a day, re-measured hourly and with every radar scan. Backtested Oct 2026: at a level beat the market 54-58% of the time over 10 days, only in coins swinging under ~18% a week.",
    "max_weekly_swing_pct": 18,
    "at_level_pct": 4,
    "min_touches": 3,
    "min_resolved": 3,
    "alerts": true,
    "alert_cap": 6,
    "cooldown_days": 21,
    "track_days": 10,
    "recent": {
      "_note": "Context on each row, not used to pick coins: 30-day swing support/ceiling from 4h candles and the 30-day and weekly VWAP. Tested Oct 2026: recent levels and VWAP pullbacks showed no edge; 10%+ above VWAP lagged (the 'stretched' tag).",
      "days": 30,
      "pivot_hours": 12,
      "min_touches": 2,
      "stretched_pct": 10
    }
  },

  "strength": {
